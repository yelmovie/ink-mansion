{
  "name": "ink-mansion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "scan:assets": "node scripts/scan-assets.mjs",
    "convert:assets": "node scripts/convert-assets.mjs",
    "simulate": "node scripts/simulate-30-sessions.mjs",
    "subset:fonts": "node scripts/subset-fonts.mjs",
    "verify": "npm run typecheck && npm run validate:data && npm run validate:assets && npm run test && npm run subset:fonts && npm run build"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/three": "^0.185.4",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.33.0",
    "subset-font": "^2.5.0",
    "three": "^0.185.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
